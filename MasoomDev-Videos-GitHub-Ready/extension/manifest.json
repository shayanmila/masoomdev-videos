{
  "manifest_version": 3,
  "name": "MasoomDev Screen Recorder",
  "version": "0.5.0",
  "description": "Private, local-first screen recording with microphone and live browser-tab annotations.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MasoomDev Screen Recorder"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
